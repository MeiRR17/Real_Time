# Inert production template. DO NOT deploy unchanged.
# Copy to config/.env.production locally, provide approved secret manager values, and validate environment-specific settings.
# Production source credentials/hosts must never be committed. Public Git history may retain earlier values.
POSTGRES_USER=telephony_dev
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=require
POSTGRES_POOL_SIZE=1
POSTGRES_MAX_OVERFLOW=1
CUCM_HOST=cucm.example.invalid
CUCM_USERNAME=
CUCM_PASSWORD=
CUCM_PORT=8443
CUCM_VERIFY_SSL=false
CUCM_TIMEOUT=1
CUCM_RETRY_ATTEMPTS=1
UCCX_HOST=uccx.example.invalid
UCCX_USERNAME=
UCCX_PASSWORD=
UCCX_PORT=8443
UCCX_VERIFY_SSL=false
UCCX_TIMEOUT=1
UCCX_RETRY_ATTEMPTS=1
TGW_HOST=tgw.example.invalid
TGW_SNMP_COMMUNITY=
TGW_SNMP_PORT=161
TGW_SNMP_VERSION=2c
TGW_SNMP_TIMEOUT=1
TGW_SNMP_RETRIES=1
SBC_HOST=sbc.example.invalid
SBC_USERNAME=
SBC_PASSWORD=
SBC_PORT=22
SBC_SSH_KEY_PATH=
SBC_TIMEOUT=1
SBC_RETRY_ATTEMPTS=1
ENABLE_POLLING=
POLLING_INTERVAL=1
REQUEST_TIMEOUT=1
LOG_LEVEL=INFO
LOG_FORMAT=json
MAX_WORKERS=1
KEEP_ALIVE=1
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
API_KEY_LENGTH=
RATE_LIMIT_PER_MINUTE=1
ENABLE_METRICS=
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=1
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=1
BACKUP_RETENTION_DAYS=1
BACKUP_LOCATION=./data/backups
ENVIRONMENT=production
PYTHONUNBUFFERED=1
TZ=UTC
COMPOSE_PROJECT_NAME=telephony-demo
COMPOSE_FILE=docker-compose.yml
USE_REAL_CUCM=false
USE_REAL_UCCX=false
USE_REAL_TGW=false
USE_REAL_SBC=false
USE_REAL_CMS=false
USE_REAL_IMP=false
USE_REAL_MEETING_PLACE=false
USE_REAL_EXPRESSWAY=false
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT=1
DATABASE_POOL_RECYCLE=1
REDIS_MAX_MEMORY=1
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_SAVE_INTERVAL=1
WORKER_PROCESSES=1
WORKER_CONNECTIONS=1
KEEPALIVE_TIMEOUT=1
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=1
LOG_BACKUP_COUNT=false
LOG_ROTATION=daily
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST
CORS_ALLOW_HEADERS=Content-Type,Authorization
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BURST=1
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT=1
HEALTH_CHECK_ENABLED=false
HEALTH_CHECK_TIMEOUT=1
METRICS_ENABLED=false
METRICS_PATH=/metrics
ALERT_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=alert_email_smtp.example.invalid
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
BACKUP_SCHEDULE=
BACKUP_COMPRESSION=false
BACKUP_ENCRYPTION=false
BACKUP_STORAGE_TYPE=local
BACKUP_LOCAL_PATH=./data/backups
